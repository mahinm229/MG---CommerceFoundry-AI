# ============================================================
# MG CommerceFoundry AI — environment configuration
# Copy this file to ".env" (in this same folder, or in the
# "Node Project" folder) and replace every placeholder value.
# NEVER commit or share a real .env file.
# ============================================================

# Runtime environment: development | test | production
NODE_ENV=development

# Port the API listens on
API_PORT=4000

# Exact origin of the web app (used for CORS and the mutating-request origin check)
WEB_ORIGIN=http://localhost:3000

# MongoDB connection string (local Docker default shown)
MONGODB_URI=mongodb://127.0.0.1:27017/commercefoundry

# Session signing secret — MUST be a unique random string of at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<redacted>

# Set to true only behind a trusted reverse proxy that overwrites forwarded headers
TRUST_PROXY=false

# Anthropic (Claude) API key for live AI generation — leave empty to use the built-in demo generator
ANTHROPIC_API_KEY=

# Claude model used for AI generation
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# true = if no Anthropic key is set, the AI endpoint drafts copy with the built-in demo generator
AI_DEMO_FALLBACK=true

# true = return password-reset / email-verification tokens in API responses (demo/local only; keep false in production)
EXPOSE_ACTION_TOKENS=false

# Public URL of the API, used by the web app at build/runtime
NEXT_PUBLIC_API_URL=http://localhost:4000
